{
  "version": 1,
  "axes": {
    "depth": ["simple", "accessible", "technical", "expert"],
    "task": ["explain", "compare", "brainstorm", "analyze", "summarize"],
    "reasoning": ["direct", "socratic", "debate", "guided"],
    "style": ["normal", "meme", "concise", "academic"]
  },
  "capabilities": [
    "requires_search",
    "requires_diagram",
    "requires_context",
    "requires_citations"
  ],
  "incompatible": [
    {
      "when": {"reasoning": "socratic", "task": "summarize"},
      "message": "Socratic reasoning is incompatible with summarize because it should ask targeted questions instead of compressing content."
    },
    {
      "when": {"style": "meme", "depth": "expert"},
      "message": "Meme style is incompatible with expert depth because the style intentionally removes peer-level precision."
    }
  ]
}
