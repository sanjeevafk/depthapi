{
  "sources": [
    {
      "name": "CPython Docs",
      "root": "datasets/cpython/Doc",
      "namespace": "trusted_official_docs",
      "priority": "P0",
      "source_type": "markdown",
      "tags": ["python", "official-docs", "cpython"],
      "include_globs": ["**/*.rst"],
      "exclude_globs": ["**/_static/**", "**/tools/**", "**/.git/**", "**/.github/**"],
      "exclude_noisy": ["**/genindex*", "**/search*", "**/changelog*"]
    },
    {
      "name": "Node.js API Docs",
      "root": "datasets/node/doc/api",
      "namespace": "trusted_official_docs",
      "priority": "P0",
      "source_type": "markdown",
      "tags": ["nodejs", "official-docs", "runtime"],
      "include_globs": ["**/*.md"],
      "exclude_globs": ["**/.git/**", "**/.github/**", "**/assets/**", "**/images/**"],
      "exclude_noisy": ["**/all.md", "**/deprecations.md", "**/changelogs/**"]
    },
    {
      "name": "React.dev Content",
      "root": "datasets/react.dev/src/content",
      "namespace": "trusted_official_docs",
      "priority": "P0",
      "source_type": "markdown",
      "tags": ["react", "official-docs", "frontend"],
      "include_globs": ["**/*.md", "**/*.mdx"],
      "exclude_globs": ["**/.git/**", "**/.github/**", "**/images/**", "**/public/**"]
    },
    {
      "name": "Kubernetes Website EN",
      "root": "datasets/website/content",
      "namespace": "trusted_official_docs",
      "priority": "P0",
      "source_type": "markdown",
      "tags": ["kubernetes", "official-docs", "devops"],
      "include_globs": ["en/**/*.md"],
      "english_allowlist": ["en/**"],
      "exclude_globs": ["**/.git/**", "**/.github/**", "**/static/**", "**/assets/**", "**/images/**"]
    },
    {
      "name": "MDN Content EN-US",
      "root": "datasets/content/files",
      "namespace": "trusted_official_docs",
      "priority": "P0",
      "source_type": "markdown",
      "tags": ["mdn", "web", "official-docs"],
      "include_globs": ["en-us/**/*.md"],
      "english_allowlist": ["en-us/**"],
      "exclude_globs": ["**/.git/**", "**/.github/**", "**/jsondata/**", "**/sidebars/**", "**/images/**"]
    },
    {
      "name": "Full-Stack FastAPI Template",
      "root": "datasets/full-stack-fastapi-template",
      "namespace": "trusted_framework_examples",
      "priority": "P1",
      "source_type": "code",
      "tags": ["fastapi", "template", "fullstack", "python", "typescript"],
      "allowed_extensions": [".md", ".txt", ".html", ".py", ".ts", ".tsx", ".js", ".jsx"],
      "include_globs": [
        "README.md",
        "CONTRIBUTING.md",
        "development.md",
        "deployment.md",
        "backend/app/main.py",
        "backend/app/crud.py",
        "backend/app/models.py",
        "backend/app/initial_data.py",
        "backend/app/core/config.py",
        "backend/app/core/security.py",
        "backend/app/api/deps.py",
        "backend/app/api/routes/*.py",
        "frontend/src/main.tsx",
        "frontend/src/utils.ts",
        "frontend/src/routeTree.gen.ts",
        "frontend/src/vite-env.d.ts"
      ],
      "exclude_globs": [
        "**/.git/**",
        "**/.github/**",
        "**/__pycache__/**",
        "**/.venv/**",
        "**/node_modules/**",
        "**/.env",
        "**/*.lock",
        "**/*.pyc",
        "**/tests/**",
        "**/dist/**",
        "**/build/**",
        "frontend/src/components/**",
        "frontend/src/styles/**",
        "frontend/src/assets/**"
      ]
    },
    {
      "name": "System Design Primer",
      "root": "datasets/system-design-primer",
      "namespace": "system_design",
      "priority": "P1",
      "source_type": "markdown",
      "tags": ["system-design", "architecture", "interview"],
      "include_globs": ["README.md", "solutions/**/*.md", "resources/**/*.md"],
      "exclude_globs": ["**/.git/**", "**/.github/**", "**/images/**", "**/README-*.md"]
    }
  ]
}
