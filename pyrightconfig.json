{
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "api"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "api/tests"
  ],
  "typeCheckingMode": "basic",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        ".",
        "api"
      ]
    }
  ],
  "strict": [
    "api/routers/query.py",
    "api/services/inference/inference.py"
  ]
}
