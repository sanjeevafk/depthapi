FROM python:3.12-slim

WORKDIR /app

COPY api/requirements.txt /app/api-requirements.txt
COPY scripts/ingest_corpus/requirements-ingest.txt /app/requirements-ingest.txt

RUN pip install --no-cache-dir -r /app/api-requirements.txt && \
    pip install --no-cache-dir -r /app/requirements-ingest.txt pandas pyarrow datasets rank-bm25

COPY . /app

CMD ["python", "scripts/ingest_corpus/build_research_corpus.py"]
