# Copy to .env.local and replace values as needed.
DATABASE_URL=postgresql://depthapi:depthapi@localhost:5432/depthapi
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768
DEV_API_KEYS=replace-with-a-development-api-key

# Optional model providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional Turso/libSQL edge replica
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Hugging Face publishing
HF_TOKEN=
HF_REPO_ID=
