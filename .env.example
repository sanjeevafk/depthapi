# === LOCAL-FIRST DEVELOPMENT DEFAULTS ===
ENVIRONMENT=development
AUTH_PROVIDER_MODE=env
DEV_API_KEYS=sk-depth-local-dev

# Local Redis via docker compose. If Upstash vars are set, they take precedence.
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configure at least one provider key below for real query responses.
LLM_TIMEOUT_SECONDS=60
OPENROUTER_TIMEOUT_SECONDS=90
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=

# Safe local defaults
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_USER_HASH_SALT=change-me-to-a-long-random-string
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# Optional cloud integrations. Leave blank for local-first development.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
LOCAL_PGVECTOR_URL=
LOCAL_PGVECTOR_SECRET_KEY=

# Legacy optional integrations
RESEND_API_KEY=
RESEND_FROM=
DODO_WEBHOOK_SECRET=
DODO_API_KEY=
DODO_ENVIRONMENT=test_mode
DODO_WEBHOOK_ENDPOINT=
DODO_WEBHOOK_URL=
DODO_PAYMENT_LINK_ID=
CHECKOUT_RATE_LIMIT_PER_MINUTE=10

# Frontend-safe local defaults
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=
